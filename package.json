{
  "name": "evolve-sim-lab",
  "version": "0.1.0",
  "description": "Evolutionaeres Tamagotchi - Sim-Labor: schlanke Engine + Referenz-Orakel + Trainings-Schleife",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "oracle": "python3 oracle/generate_benchmark.py",
    "train": "node dist/training/fit.js",
    "demo": "node dist/cli/demo.js",
    "ecology": "npm run build && node tools/ecology-check.mjs",
    "reality": "npm run build && node tools/reality-check.mjs",
    "ecology-full": "npm run build && node tools/ecology-full.mjs",
    "all": "npm run build && npm run oracle && npm run train && node tools/ecology-check.mjs && node tools/reality-check.mjs",
    "parity": "npm run build && node tools/parity.mjs && python3 oracle/check_parity.py",
    "app-parity": "npm run build && node tools/app-parity.mjs",
    "mf-fidelity": "npm run build && node tools/mf-fidelity.mjs",
    "pop-check": "npm run build && node tools/pop-check.mjs",
    "branching-check": "npm run build && node tools/branching-check.mjs",
    "world-check": "npm run build && node tools/world-check.mjs",
    "coevolution-check": "npm run build && node tools/coevolution-check.mjs",
    "symbiosis-check": "npm run build && node tools/symbiosis-check.mjs",
    "seasonal-check": "npm run build && node tools/seasonal-check.mjs",
    "lifehistory-check": "npm run build && node tools/lifehistory-check.mjs",
    "phenomena-check": "npm run build && node tools/phenomena-check.mjs",
    "ablation-check": "npm run build && node tools/ablation-check.mjs",
    "distribution-check": "npm run build && node tools/distribution-check.mjs",
    "census-check": "npm run build && node tools/census-check.mjs",
    "spectrum-check": "npm run build && node tools/spectrum-check.mjs",
    "oracle-swarm": "npm run build && node tools/spectrum-check.mjs --oracle",
    "seed-check": "npm run build && node tools/seed-check.mjs",
    "rarity-check": "npm run build && node tools/rarity-check.mjs",
    "bundle-app": "npm run build && node tools/bundle-app-core.mjs && node tools/bundle-app-fitness.mjs",
    "app-fitness-check": "npm run build && node tools/bundle-app-fitness.mjs --check",
    "app-world-smoke": "npm run bundle-app && node tools/app-parity.mjs && node tools/mf-fidelity.mjs && node tools/app-world-smoke.mjs",
    "exemplar-check": "node tools/exemplar-check.mjs",
    "key-check": "node tools/key-check.mjs",
    "build-catalog": "NODE_USE_ENV_PROXY=1 node tools/build-catalog.mjs",
    "catalog-check": "node tools/catalog-check.mjs",
    "story-check": "node tools/story-check.mjs",
    "influence-check": "node tools/influence-check.mjs",
    "ui-calm-check": "node tools/ui-calm-check.mjs",
    "type-audit": "node tools/type-audit.mjs",
    "type-check": "node tools/type-audit.mjs --strict",
    "layer-import-check": "node tools/layer-import-check.mjs",
    "story-import-check": "node tools/story-import-check.mjs",
    "build-story-extra": "node tools/build-story-extra.mjs",
    "build-gene-explain": "node tools/build-gene-explain.mjs",
    "plain-import-check": "node tools/plain-import-check.mjs",
    "gene-import-check": "node tools/gene-import-check.mjs",
    "challenge-import-check": "node tools/challenge-import-check.mjs",
    "build-influences": "node tools/build-influences.mjs",
    "world-demo": "npm run build && node dist/cli/world-demo.js",
    "serve": "python3 -m http.server 8000",
    "design-audit": "node tools/design-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "playwright-core": "^1.49.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
